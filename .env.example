# Vertex AI via Application Default Credentials (no API keys).
# Local auth: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Langfuse Cloud (evals + tracing, Phase 2). Keys from the Langfuse project settings; never commit real values.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Optional: local dev defaults (docker-compose, localhost only) are used when these are unset.
# DATABASE_URL=postgresql://postgres:dev@localhost:5432/ai_lawyer
# REDIS_URL=redis://localhost:6379/0
# AI_FAKE=1  # deterministic fake model: no Vertex calls (e2e, load tests)
